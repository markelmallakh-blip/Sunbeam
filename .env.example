# Public, absolute origin of the deployed site. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.sunbeamspaces.com

# Server-only. Endpoint that receives newsletter sign-ups as JSON { "email": string } (e.g. a Mailchimp/Brevo/Zapier webhook).
# When unset, the footer form reports that sign-ups are unavailable instead of pretending to succeed.
NEWSLETTER_WEBHOOK_URL=
